# ============================================================
#  Alle Einstellungen des Bots – diese Datei kopieren nach ".env"
# ============================================================

# --- Pflicht ------------------------------------------------
# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=dein_bot_token_hier

# --- Kanäle (Rechtsklick auf Kanal -> "Kanal-ID kopieren", Entwicklermodus nötig)
# Kanal für Audit-Log / Server-Logs (z. B. #dc-logs)
LOG_CHANNEL_ID=0
# Kanal für den täglichen "Vers des Tages" (mehrere Kanäle: IDs mit Komma trennen)
VERSE_CHANNEL_ID=0

# --- Optional -----------------------------------------------
# Server-ID: Slash-Commands erscheinen dann sofort (sonst bis zu 1 Stunde Verzögerung)
GUILD_ID=0

# Zeitzone und Uhrzeit des täglichen Verses (Standard: 00:00 Berliner Zeit)
TIMEZONE=Europe/Berlin
VERSE_HOUR=0
VERSE_MINUTE=0

# Musik
DEFAULT_VOLUME=100          # Start-Lautstärke in % (0-200)
IDLE_DISCONNECT_SECONDS=300 # Bot verlässt den Sprachkanal nach X Sekunden ohne Musik (0 = nie)
